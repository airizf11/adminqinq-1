// adminqinq/src/app/track/[orderNumber]/page.tsx
import { cotebek } from '@/lib/cotebek';
import Link from 'next/link';

type TrackingData = {
  orderNumber: string;
  status: string;
  paymentStatus: 'PAID' | 'UNPAID';
  dueDate: string | null;
  createdAt: string;
  customerName: string | null;
  items: { itemName: string; qty: number }[];
  statusHistory: { status: string | null; timestamp: string }[];
};

const STATUS_LABEL: Record<string, string> = {
  RECEIVED: 'Diterima',
  IN_PROCESS: 'Diproses',
  READY: 'Siap Diambil',
  DONE: 'Selesai',
};

const ALL_STEPS = ['RECEIVED', 'IN_PROCESS', 'READY', 'DONE'];

export default async function TrackOrderPage({ params }: { params: Promise<{ orderNumber: string }> }) {
  const { orderNumber } = await params;

  let data: TrackingData | null = null;

  try {
    const res = await cotebek<{ data: TrackingData }>(`/orders/track/${orderNumber}`, { requireAuth: false });
    data = res.data;
  } catch {
    data = null;
  }

  if (!data) {
    return (
      <div className="min-h-screen flex flex-col items-center justify-center px-6 text-center">
        <h1 className="text-lg font-semibold mb-2">Order tidak ditemukan</h1>
        <p className="text-sm text-gray-500 mb-6">Cek lagi nomor order-nya ya.</p>
        <Link href="/track" className="text-sm text-blue-600">← Coba nomor lain</Link>
      </div>
    );
  }

  const isCancelled = data.status === 'CANCELLED';
  const currentStepIndex = ALL_STEPS.indexOf(data.status);
  const historyByStatus = new Map(data.statusHistory.filter((h) => h.status).map((h) => [h.status, h.timestamp]));

  return (
    <div className="min-h-screen px-6 py-10 max-w-sm mx-auto">
      <h1 className="text-lg font-semibold mb-1">{data.orderNumber}</h1>
      {data.customerName && <p className="text-sm text-gray-500 mb-6">{data.customerName}</p>}

      {data.paymentStatus === 'UNPAID' && !isCancelled && (
       <div className="border border-yellow-300 bg-yellow-50 rounded-lg p-3 text-center text-yellow-700 text-sm font-medium mb-4">
         💰 Belum lunas — mohon bayar saat pengambilan.
       </div>
     )}

      {isCancelled ? (
        <div className="border border-red-200 bg-red-50 rounded-lg p-4 text-center text-red-600 font-medium mb-6">
          Order ini telah dibatalkan
        </div>
      ) : (
        <div className="mb-6 space-y-4">
          {ALL_STEPS.map((step, i) => {
            const done = i <= currentStepIndex;
            const timestamp = step === 'RECEIVED' ? data!.createdAt : historyByStatus.get(step);
            return (
              <div key={step} className="flex items-start gap-3">
                <div className={`w-3 h-3 rounded-full mt-1 shrink-0 ${done ? 'bg-green-600' : 'bg-gray-200'}`} />
                <div>
                  <div className={`text-sm font-medium ${done ? '' : 'text-gray-400'}`}>{STATUS_LABEL[step]}</div>
                  {timestamp && (
                    <div className="text-xs text-gray-400">
                      {new Date(timestamp).toLocaleString('id-ID', { dateStyle: 'medium', timeStyle: 'short' })}
                    </div>
                  )}
                </div>
              </div>
            );
          })}
        </div>
      )}

      <div className="border rounded-lg p-3 mb-4">
        <h2 className="text-xs text-gray-500 mb-2">Item</h2>
        <ul className="space-y-1">
          {data.items.map((item, i) => (
            <li key={i} className="text-sm flex justify-between">
              <span>{item.itemName}</span>
              <span className="text-gray-500">x{item.qty}</span>
            </li>
          ))}
        </ul>
      </div>

      {data.dueDate && (
        <p className="text-xs text-gray-400 text-center">
          Estimasi selesai: {new Date(data.dueDate).toLocaleDateString('id-ID')}
        </p>
      )}
    </div>
  );
}