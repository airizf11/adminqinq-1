@import "tailwindcss";

:root {
  --background: #ffffff;
  --foreground: #171717;
}

@theme inline {
  --color-background: var(--background);
  --color-foreground: var(--foreground);
  --font-sans: var(--font-geist-sans);
  --font-mono: var(--font-geist-mono);
}

@media (prefers-color-scheme: dark) {
  :root {
    --background: #0a0a0a;
    --foreground: #ededed;
  }
}

body {
  background: var(--background);
  color: var(--foreground);
  font-family: Arial, Helvetica, sans-serif;
}

# --- Backup - Main Color

:root {
  /* BACKGROUND & TEXT */
  --background: #ffffff;
  --foreground: #0f2744; /* brand-navy */
  
  /* CARDS & POPOVERS */
  --card: #ffffff;
  --card-foreground: #0f2744;
  --popover: #ffffff;
  --popover-foreground: #0f2744;
  
  /* PRIMARY (Warna utama: Brand Navy) */
  --primary: #0f2744;
  --primary-foreground: #ffffff;
  
  /* SECONDARY (Warna aksen/kedua: Brand Gold) */
  --secondary: #f0a500; 
  --secondary-foreground: #0f2744; 
  
  /* MUTED & ACCENT (Warna latar lembut: Brand Sky) */
  --muted: #e8f4fd;
  --muted-foreground: #1a3a5c; /* brand-navy-mid */
  --accent: #e8f4fd;
  --accent-foreground: #0f2744;
  
  /* DESTRUCTIVE (Error/Hapus) */
  --destructive: oklch(0.577 0.245 27.325); /* Tetap merah bawaan */
  --destructive-foreground: #ffffff;

  /* BORDERS & INPUTS */
  --border: #e2e8f0; 
  --input: #e2e8f0;
  
  /* RING (Garis fokus aksesibilitas: Pakai Brand Gold biar elegan!) */
  --ring: #f0a500;

  /* RADIUS (Ujung melengkung) */
  --radius: 0.75rem; /* Sedikit lebih melengkung agar ramah/modern */
  
  /* CHART & SIDEBAR (Bisa dibiarkan bawaan dulu) */
  --chart-1: oklch(0.87 0 0);
  --chart-2: oklch(0.556 0 0);
  --chart-3: oklch(0.439 0 0);
  --chart-4: oklch(0.371 0 0);
  --chart-5: oklch(0.269 0 0);
  --sidebar: #ffffff;
  --sidebar-foreground: #0f2744;
  --sidebar-primary: #0f2744;
  --sidebar-primary-foreground: #ffffff;
  --sidebar-accent: #e8f4fd;
  --sidebar-accent-foreground: #0f2744;
  --sidebar-border: #e2e8f0;
  --sidebar-ring: #f0a500;
}